#!/usr/bin/env bash
set -u
: "${STUB_RECORD:=/tmp/epic-loop-stub-record.txt}"
# The driver's version gate reads this before any call; answer with the floor
# it requires so the gate passes.
if [[ "${1:-}" == --version ]]; then
    printf '2.1.272 (Claude Code)\n'
    exit 0
fi
{
  printf -- '--- stub call ---\n'
  for a in "$@"; do printf '  arg: %s\n' "$a"; done
} >>"$STUB_RECORD"
if printf '%s\n' "$@" | grep -q -- '--resume'; then
    printf 'STUB: working call ran (no beads were worked)\n'
    sleep 1
    exit 0
fi
printf 'STUB: arming call ran\n'
exit 0
