#!/usr/bin/env bash
# run-arm ARM_DIR SKILL_DIR -- run one eval arm in a sealed nested session.
#
# The arm runs as `claude -p` in a throwaway git repo with a local bare origin
# and its own beads tracker. A stub `claude` sits first on the arm's PATH, so
# every process the arm spawns -- including the epic-loop driver, which
# resolves claude by bare name through env -- gets the stub and cannot reach
# the API. The seal is a property of the environment, not an instruction the
# model could skip.
#
# The arm itself has to be the real claude, so it is resolved before the stub
# goes on PATH and invoked by absolute path. That single launch is the only
# thing that escapes the seal.
set -Eeuo pipefail
ARM="${1:?usage: run-arm ARM_DIR SKILL_DIR}"
SKILL="${2:?usage: run-arm ARM_DIR SKILL_DIR}"
WS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$ARM/sandbox/repo"
EPIC="$(cat "$ARM/sandbox/fixture-epic.txt")"
OUT="$ARM/outputs"

REAL_CLAUDE="$(command -v claude)"
[[ -n "$REAL_CLAUDE" ]] || { echo "ABORT: no claude on PATH" >&2; exit 2; }

export PATH="$WS/stubs:$PATH"
export STUB_RECORD="$OUT/stub-record.txt"
: >"$STUB_RECORD"
[[ "$REAL_CLAUDE" != "$WS/stubs/claude" ]] \
    || { echo "ABORT: resolved the stub as the real claude" >&2; exit 2; }
command -v claude | grep -q "^$WS/stubs/claude$" \
    || { echo "ABORT: the stub is not first on PATH" >&2; exit 2; }

PROMPT="Read ${SKILL}/SKILL.md and do exactly what it says for this task:

/epic-loop ${EPIC}

That skill's base directory is ${SKILL}. You are already in the target repository."

cd "$REPO"
env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN \
  "$REAL_CLAUDE" -p "$PROMPT" \
    --permission-mode bypassPermissions \
    --model claude-opus-5 \
    --max-turns "${MAX_TURNS:-30}" \
    --max-budget-usd "${BUDGET:-5}" \
    --output-format json >"$OUT/result.json" 2>"$OUT/stderr.txt" || true

# The launcher detaches the driver, so it can still be making its stub calls
# after the arm exits. Wait for it before reading what it left behind.
for _ in $(seq 60); do
    pgrep -f "scripts/epic-loop $EPIC" >/dev/null || break
    sleep 1
done

# State the grader reads, captured while the sandbox is still intact.
{
  echo "=== git worktree list ==="; git -C "$REPO" worktree list
  echo "=== git branch -a ==="; git -C "$REPO" branch -a
  echo "=== child bead status ==="
  (cd "$REPO" && bd list --parent "$EPIC" --status all --json \
     | jq -r '.[] | "\(.id)\t\(.status)"')
  echo "=== epic notes ==="
  (cd "$REPO" && bd show "$EPIC" --json | jq -r 'if type=="array" then .[0] else . end | .notes // "(none)"' 2>/dev/null \
     || echo "(unreadable)")
  echo "=== epic labels ==="
  (cd "$REPO" && bd show "$EPIC" --json | jq -r 'if type=="array" then .[0] else . end | (.labels // []) | join(",")' 2>/dev/null \
     || echo "(unreadable)")
} >"$OUT/post-state.txt" 2>&1
echo "arm done: $ARM"
